
name: Docker CI CD

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: self-hosted

    steps:
      - name: Checkout source code
        uses: actions/checkout@v4

      - name: Build and Deploy
        run: |
          docker compose up -d --build

      - name: Check containers
        run: |
          docker compose ps

      - name: Verify application
        run: |
          for i in {1..10}; do
            if curl -fsS http://localhost:8080/; then
              exit 0
            fi
            sleep 3
          done
          exit 1

